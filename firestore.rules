rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function auth() {
      return request.auth;
    }

    // Helper: Get user document from Firestore (strictly authoritative)
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Helper: Check if current user is an OWNER of the target business
    function isOwner(businessId) {
      return auth() != null && getUserData(auth().uid).role == 'OWNER' && getUserData(auth().uid).businessId == businessId;
    }

    // Helper: Check if current user belongs to the target business
    function isMember(businessId) {
      return auth() != null && getUserData(auth().uid).businessId == businessId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Businesses collection
    match /businesses/{businessId} {
      allow get: if isValidId(businessId);
      allow list: if auth() != null;
      allow create: if auth() != null;
      allow update: if isOwner(businessId);
      allow delete: if false;
    }

    // System users - ONLY owners can manage staff; users can read their own profiles
    match /users/{userId} {
      allow get: if auth() != null && (auth().uid == userId || isOwner(existing().businessId));
      allow list: if auth() != null; // Listing is filtered by businessId in client queries
      allow create: if auth() != null; // Allow first-time registration
      allow update: if auth() != null && (
        (auth().uid == userId && incoming().role == existing().role) || // User can update self but not change role
        isOwner(existing().businessId) // Owner can update staff
      );
      allow delete: if false;
    }

    // Product catalog - Only owners can add/edit/archive products
    match /products/{productId} {
      allow read: if isMember(existing().businessId);
      allow list: if auth() != null;
      allow create: if isOwner(incoming().businessId);
      allow update: if isOwner(existing().businessId);
      allow delete: if false;
    }

    // Inventory - Members can read/write current stock levels
    match /inventory/{inventoryId} {
      allow read: if isMember(existing().businessId);
      allow list: if auth() != null;
      allow create: if isMember(incoming().businessId);
      allow update: if isMember(existing().businessId);
      allow delete: if false;
    }

    // Shifts - Workers can create/update active shifts; only owners can see historical reports (simplified for now)
    match /shifts/{shiftId} {
      allow read, list: if isMember(resource.data.businessId);
      allow create: if isMember(incoming().businessId);
      allow update: if isMember(existing().businessId) && (
        existing().status != 'CLOSED' || isOwner(existing().businessId)
      );
      allow delete: if false;
    }

    // Shift stock audit line items
    match /shiftStockItems/{itemId} {
      allow read, list: if auth() != null; // Strictly filtered by shiftId/businessId in client
      allow create: if isMember(incoming().businessId);
      allow update: if isMember(existing().businessId);
      allow delete: if false;
    }

    // Stock additions and adjustments
    match /stockAdditions/{additionId} {
      allow read, list: if auth() != null;
      allow create: if isMember(incoming().businessId);
      allow update: if isMember(existing().businessId);
      allow delete: if isOwner(existing().businessId);
    }

    // Stock movements audit log
    match /stockMovements/{movementId} {
      allow read, list: if isMember(resource.data.businessId);
      allow create: if isMember(incoming().businessId);
      allow update: if false; // Audit logs are immutable
      allow delete: if false;
    }

    // Expenses - Workers log them; only Owners can delete them
    match /expenses/{expenseId} {
      allow read, list: if isMember(resource.data.businessId);
      allow create: if isMember(incoming().businessId);
      allow update: if isMember(existing().businessId);
      allow delete: if isOwner(existing().businessId);
    }

    // Discrepancies - Workers report them; only Owners can resolve them
    match /discrepancies/{discrepancyId} {
      allow read, list: if isMember(resource.data.businessId);
      allow create: if isMember(incoming().businessId);
      allow update: if isOwner(existing().businessId);
      allow delete: if false;
    }

    // Operational event logs
    match /events/{eventId} {
      allow read, list: if isMember(resource.data.businessId);
      allow create: if isMember(incoming().businessId);
      allow update: if false;
      allow delete: if false;
    }

    // M-Pesa accounts
    match /mpesaAccounts/{accountId} {
      allow read, list: if isMember(resource.data.businessId);
      allow create, update: if isOwner(incoming().businessId || existing().businessId);
      allow delete: if false;
    }

    // Inter-business stock transfers
    match /interTransfers/{transferId} {
      allow read, list: if isMember(resource.data.fromBusinessId) || isMember(resource.data.toBusinessId);
      allow create: if isMember(incoming().fromBusinessId);
      allow update: if isMember(existing().fromBusinessId) || isMember(existing().toBusinessId);
      allow delete: if false;
    }

    // Partner bar linkages
    match /partners/{partnerId} {
      allow read, list: if isMember(resource.data.businessId);
      allow create, update, delete: if isOwner(incoming().businessId || existing().businessId);
    }

    // Handover drafts
    match /handoverDrafts/{draftId} {
      allow read, write: if auth() != null; // Drafts are ephemeral and private to the worker session (implied)
    }
  }
}

